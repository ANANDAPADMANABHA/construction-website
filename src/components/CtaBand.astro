---
import { site, links } from '../config/site';
import Icon from './Icon.astro';

interface Props {
  title?: string;
  text?: string;
  variant?: 'clay' | 'ink';
}
const {
  title = 'Ready to build with Arcfinity?',
  text = 'Tell us about your plot, your budget and your timeline. Get a free, no-obligation consultation with our team in Thiruvananthapuram.',
  variant = 'clay',
} = Astro.props;
---
<section class={`cta-band cta-band--${variant}`}>
  <div class="container cta-band__inner">
    <div class="cta-band__copy">
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta-band__actions">
      <a href="/contact" class="btn btn--ink">Get a Free Consultation</a>
      <a href={links.whatsapp()} class="btn btn--outline" rel="nofollow noopener" target="_blank">
        <Icon name="whatsapp" size={18} /> WhatsApp Us
      </a>
      <a href={links.tel} class="cta-band__call">
        <Icon name="phone" size={18} /> {site.contact.phoneDisplay}
      </a>
    </div>
  </div>
</section>

<style>
  .cta-band { padding-block: clamp(2.75rem, 6vw, 4.5rem); }
  .cta-band--clay { background: var(--clay); color: #fff; }
  .cta-band--ink { background: var(--ink); color: var(--on-dark); }
  .cta-band__inner {
    display: grid;
    gap: 1.75rem;
    align-items: center;
  }
  .cta-band h2 { color: #fff; font-size: var(--step-3); max-width: 18ch; }
  .cta-band p { margin-top: 0.7rem; max-width: 52ch; opacity: 0.92; }
  .cta-band__actions { display: flex; flex-wrap: wrap; gap: 0.9rem; align-items: center; }
  .cta-band--clay .btn--ink { --btn-bg: #fff; --btn-fg: var(--ink); }
  .cta-band--clay .btn--outline { --btn-fg: #fff; border-color: rgba(255,255,255,0.5); }
  .cta-band--clay .btn--outline:hover { border-color: #fff; }
  .cta-band__call {
    display: inline-flex; align-items: center; gap: 0.45rem;
    font-family: var(--font-display); font-weight: 600; color: #fff; text-decoration: none;
  }
  @media (min-width: 860px) {
    .cta-band__inner { grid-template-columns: 1.3fr 1fr; gap: 3rem; }
    .cta-band__actions { justify-content: flex-end; }
  }
</style>
