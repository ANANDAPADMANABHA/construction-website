---
import Icon from './Icon.astro';

interface Props {
  slug: string;
  title: string;
  summary: string;
  icon: string;
}
const { slug, title, summary, icon } = Astro.props;
---
<a href={`/services/${slug}`} class="service-card card card--link">
  <span class="service-card__icon"><Icon name={icon} size={26} /></span>
  <h3 class="service-card__title">{title}</h3>
  <p class="service-card__summary">{summary}</p>
  <span class="arrow-link service-card__link">
    Learn more <Icon name="arrow" size={16} />
  </span>
</a>

<style>
  .service-card { display: flex; flex-direction: column; height: 100%; text-decoration: none; color: inherit; }
  .service-card__icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 3rem; height: 3rem; border-radius: var(--radius);
    background: var(--clay-tint); color: var(--clay-deep); margin-bottom: 1rem;
  }
  .service-card__title { font-size: var(--step-1); margin-bottom: 0.5rem; }
  .service-card__summary { color: var(--muted); font-size: 0.96rem; flex: 1; }
  .service-card__link { margin-top: 1.1rem; font-size: 0.92rem; }
</style>
