  handshake: '<path d="m11 17 2 2 5-5 3 3"/><path d="M3 12 8 7l4 4 3-3 3 3"/><path d="m3 12 4 4"/>',
  users: '<circle cx="9" cy="8" r="3.2"/><path d="M3 20a6 6 0 0 1 12 0"/><path d="M16 5.5a3.2 3.2 0 0 1 0 6M21 20a6 6 0 0 0-4-5.6"/>',
  chat: '<path d="M21 12a8 8 0 0 1-11.5 7.2L3 21l1.8-5.5A8 8 0 1 1 21 12Z"/>',
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/>',
  facebook: '<path d="M14 9V7c0-1 .5-2 2-2h2V2h-3c-2.5 0-4 1.7-4 4v3H8v3h3v9h3v-9h3l1-3Z"/>',
  youtube: '<rect x="2" y="5" width="20" height="14" rx="4"/><path d="m10 9 5 3-5 3Z"/>',
  linkedin: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 10v7M7 7v.01M11 17v-4a2 2 0 0 1 4 0v4M11 10v7"/>',
  google: '<path d="M21 12.2c0-.7-.1-1.3-.2-2H12v3.8h5.1a4.4 4.4 0 0 1-1.9 2.9v2.4h3a9 9 0 0 0 2.8-7.1Z"/><path d="M12 21a8.8 8.8 0 0 0 6.1-2.2l-3-2.4a5.5 5.5 0 0 1-8.2-2.9H3.8v2.5A9 9 0 0 0 12 21Z"/><path d="M6.9 13.5a5.4 5.4 0 0 1 0-3.4V7.6H3.8a9 9 0 0 0 0 8.1Z"/><path d="M12 6.6a4.9 4.9 0 0 1 3.4 1.3l2.6-2.5A8.7 8.7 0 0 0 12 3a9 9 0 0 0-8.2 4.6l3.1 2.5A5.4 5.4 0 0 1 12 6.6Z"/>',
