---
/**
 * Inline SVG icon set. No icon library — each icon is a tiny stroke path.
 * Usage: <Icon name="home" /> . Decorative by default (aria-hidden).
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
  label?: string; // when set, icon is announced to screen readers
}
const { name, size = 24, class: className = '', label } = Astro.props;

const a11y = label
  ? { role: 'img', 'aria-label': label }
  : { 'aria-hidden': 'true', focusable: 'false' };

// 24x24 stroke icons. `p` = <path>/<line>/<polyline> markup fragments.
const icons: Record<string, string> = {
  home: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M9.5 21v-6h5v6"/>',
  building: '<rect x="4" y="3" width="16" height="18" rx="1"/><path d="M8 7h2M8 11h2M8 15h2M14 7h2M14 11h2M14 15h2"/><path d="M10 21v-3h4v3"/>',
  renovation: '<path d="m14 6 4 4"/><path d="M3 21v-4L15 5l4 4L7 21H3Z"/><path d="M14 6 18 2l4 4-4 4"/>',
  interior: '<rect x="3" y="4" width="18" height="16" rx="1"/><path d="M3 15h18"/><path d="M7 20v-5M17 20v-5"/><path d="M7 8h4"/>',
  plan: '<rect x="3" y="3" width="18" height="18" rx="1"/><path d="M3 9h6V3M9 9v12M14 3v6h7M14 15h7"/>',
  elevation: '<path d="M3 21h18"/><path d="M6 21V9l6-4 6 4v12"/><path d="M10 21v-5h4v5"/><path d="M9 12h.01M15 12h.01"/>',
  permit: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="m9 15 2 2 4-4"/>',
  mep: '<path d="M12 2v4M12 18v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M2 12h4M18 12h4M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8"/><circle cx="12" cy="12" r="3.2"/>',
  phone: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/>',
  whatsapp: '<path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.9 5-1.3A10 10 0 1 0 12 2Z"/><path d="M8.5 7.6c.2 0 .5 0 .7.5l.9 2c.1.2.1.4 0 .6l-.5.9c-.1.2-.2.4 0 .7a7 7 0 0 0 3 3c.3.2.5.1.7-.1l.7-.8c.2-.2.4-.2.6-.1l2 .9c.3.2.4.4.4.6 0 1-.7 2-1.6 2.2-1 .3-2.4.2-4.2-.6a11 11 0 0 1-5-5c-.8-1.8-.9-3.2-.6-4.2.3-.9 1.3-1.6 2-2Z"/>',
  mail: '<rect x="2.5" y="4.5" width="19" height="15" rx="2"/><path d="m3 6 9 6 9-6"/>',
  pin: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  arrow: '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',
  arrowUpRight: '<path d="M7 17 17 7"/><path d="M8 7h9v9"/>',
  check: '<path d="m20 6-11 11-5-5"/>',
  star: '<path d="m12 3 2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 18l-5.8 3 1.1-6.5L2.6 9.8l6.5-.9Z"/>',
  quote: '<path d="M7 7H4a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h2v3H4M20 7h-3a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h2v3h-2"/>',
  shield: '<path d="M12 2 4 5v6c0 5 3.5 8.5 8 11 4.5-2.5 8-6 8-11V5Z"/><path d="m9 12 2 2 4-4"/>',
  compass: '<circle cx="12" cy="12" r="9"/><path d="m16 8-2 6-6 2 2-6Z"/>',
