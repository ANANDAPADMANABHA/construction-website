---
import Breadcrumbs from './Breadcrumbs.astro';
import type { Crumb } from '../utils/seo';

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  crumbs?: Crumb[];
}
const { eyebrow, title, intro, crumbs } = Astro.props;
---
<section class="page-header section--dark">
  <div class="page-header__lines" aria-hidden="true"></div>
  <div class="container">
    {crumbs && <Breadcrumbs items={crumbs} onDark />}
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {intro && <p class="page-header__intro">{intro}</p>}
    <slot />
  </div>
</section>

<style>
  .page-header {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 7vw, 5rem);
  }
  .page-header .eyebrow { margin-top: 1.2rem; }
  .page-header h1 { max-width: 20ch; }
  .page-header__intro {
    margin-top: 1.1rem;
    max-width: 60ch;
    color: var(--on-dark-muted);
    font-size: var(--step-1);
  }
  /* Architectural line motif — pure CSS, no image request */
  .page-header__lines {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(60rem 30rem at 90% -10%, rgba(180, 85, 45, 0.16), transparent 60%),
      repeating-linear-gradient(90deg, transparent 0 79px, rgba(255, 255, 255, 0.03) 79px 80px);
    pointer-events: none;
  }
</style>
