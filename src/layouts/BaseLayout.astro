---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingActions from '../components/FloatingActions.astro';
import { site } from '../config/site';
import {
  localBusinessSchema,
  organizationSchema,
  websiteSchema,
  type SeoProps,
} from '../utils/seo';

interface Props extends SeoProps {
  schema?: Array<Record<string, unknown>>;
  /** Add site-wide Organization/WebSite/LocalBusiness graph (home only). */
  siteSchema?: boolean;
}

const { schema = [], siteSchema = false, ...seo } = Astro.props;

const graph = siteSchema
  ? [organizationSchema(), websiteSchema(), localBusinessSchema(), ...schema]
  : schema;
---
<!doctype html>
<html lang={site.language}>
  <head>
    <BaseHead {...seo} schema={graph} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <FloatingActions />
  </body>
</html>
