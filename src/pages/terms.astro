---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { site, links } from '../config/site';
import { breadcrumbSchema } from '../utils/seo';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Terms & Conditions', path: '/terms' },
];
const updated = 'August 2025';
---
<BaseLayout
  title="Terms & Conditions"
  description="The terms governing the use of the Arcfinity website. Project-specific terms are set out in individual written agreements."
  path="/terms"
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHeader eyebrow="Legal" title="Terms & Conditions" crumbs={crumbs} />
  <section class="section">
    <div class="container prose">
      <p class="editor-note"><strong>Editor note:</strong> This is a starter template covering website use. Your actual construction/design engagements should be governed by a separate, professionally drafted agreement. Have this reviewed before publishing.</p>

      <p>Last updated: {updated}</p>

      <h2>Use of this website</h2>
      <p>This website is provided for general information about {site.name} and our services. By using it, you agree to these terms.</p>

      <h2>No binding offer</h2>
      <p>Content on this website — including service descriptions and guides — is for information only and does not constitute a binding quotation or contract. Costs, timelines and specifications for any project are confirmed only in a written agreement specific to that project.</p>

      <h2>Estimates and consultations</h2>
      <p>Consultations and preliminary estimates are provided in good faith based on the information available. Final scope and cost are established through site assessment and a signed agreement.</p>

      <h2>Intellectual property</h2>
      <p>The content, design and branding of this website are the property of {site.name} and may not be copied or reused without permission.</p>

      <h2>Third-party links</h2>
      <p>This website may link to third-party services (such as WhatsApp or Google). We are not responsible for the content or practices of those services.</p>

      <h2>Limitation of liability</h2>
      <p>We make reasonable efforts to keep information accurate and up to date but do not warrant that it is complete or error-free. We are not liable for decisions made solely on the basis of website content.</p>

      <h2>Contact</h2>
      <p>Questions about these terms? Email <a href={links.mailto}>{site.contact.email}</a> or call <a href={links.tel}>{site.contact.phoneDisplay}</a>.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .editor-note { background: var(--paper-2); border: 1px dashed var(--line-strong); border-radius: var(--radius); padding: 1rem 1.25rem; color: var(--muted); font-size: 0.9rem; }
</style>
