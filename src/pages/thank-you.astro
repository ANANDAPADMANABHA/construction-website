---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site, links } from '../config/site';
---
<BaseLayout
  title="Thank You"
  description="Thank you for contacting Arcfinity. We've received your enquiry and will be in touch shortly."
  path="/thank-you"
  noindex
>
  <section class="section thanks">
    <div class="container container--narrow">
      <span class="thanks__icon"><Icon name="check" size={36} /></span>
      <h1>Thank you — we've got your enquiry</h1>
      <p class="lead">
        Thanks for reaching out to {site.name}. A member of our team will review your
        details and get back to you within one business day.
      </p>
      <p class="text-muted">Need to reach us sooner? Call or message us directly.</p>
      <div class="thanks__actions">
        <a href={links.tel} class="btn btn--primary"><Icon name="phone" size={18} /> {site.contact.phoneDisplay}</a>
        <a href={links.whatsapp()} class="btn btn--whatsapp" rel="nofollow noopener" target="_blank"><Icon name="whatsapp" size={18} /> WhatsApp Us</a>
        <a href="/projects" class="btn btn--outline">View Our Projects</a>
      </div>
      <p class="thanks__back"><a href="/" class="arrow-link"><Icon name="arrow" size={16} class="flip" /> Back to home</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .thanks { text-align: center; }
  .thanks__icon { display: inline-flex; align-items: center; justify-content: center; width: 5rem; height: 5rem; border-radius: 50%; background: var(--clay-tint); color: var(--clay-deep); margin-bottom: 1.5rem; }
  .thanks h1 { margin-bottom: 1rem; }
  .thanks .lead { max-width: 52ch; margin-inline: auto; }
  .thanks .text-muted { margin-top: 1rem; }
  .thanks__actions { display: flex; flex-wrap: wrap; gap: 0.8rem; justify-content: center; margin-top: 2rem; }
  .thanks__back { margin-top: 2rem; }
  .thanks__back .flip { transform: rotate(180deg); }
</style>
